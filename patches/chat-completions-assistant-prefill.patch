diff --git a/src-tauri/src/proxy/handlers/openai.rs b/src-tauri/src/proxy/handlers/openai.rs
--- a/src-tauri/src/proxy/handlers/openai.rs
+++ b/src-tauri/src/proxy/handlers/openai.rs
@@ -1863,6 +1863,21 @@ pub async fn handle_chat_completions(
     if is_responses_format {
         debug!("Detected Responses API format, converting with structured role preservation");
         body = convert_codex_to_openai_request(body);
     }

+    // Gemini rejects requests whose final content turn has role=model. SillyTavern
+    // represents Assistant Prefill in Chat Completions as a terminal assistant
+    // message, which transform_openai_request would otherwise map to role=model.
+    // Reuse the same narrow compatibility rule as the Responses path: only a
+    // terminal, non-empty, plain-text assistant message without tool_calls is
+    // rewritten. Historical assistant turns, tool calls and multimodal content
+    // are deliberately left untouched. Other model families are not changed.
+    if model_name.contains("gemini") {
+        if let Some(messages) = body.get_mut("messages").and_then(Value::as_array_mut) {
+            if rewrite_terminal_assistant_prefill(messages) {
+                debug!("[Chat Completions Compat] Rewrote terminal plain-text assistant prefill for Gemini compatibility");
+            }
+        }
+    }
+
     let normalized_interaction_ledger = body.get("_interaction_ledger").cloned();
